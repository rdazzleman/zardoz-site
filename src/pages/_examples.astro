---
import Base from "../layouts/Base.astro";
import Head from "../components/Head.astro";
import { examples, modelByKey, stamp, comparisonDrafts, byCost, modelCount, hostedCount, localCount } from "../lib/examples";

// The comparison excerpts: one markdown file per model, cut verbatim from its Standard.
const excerpts = Object.fromEntries(
  Object.values(import.meta.glob("../content/examples/*.md", { eager: true })).map((mod: any) => [mod.frontmatter.model, mod]),
);

const pending = examples.status === "pending";
const unpublished = examples.status === "run";
const standIns = examples.demo.filter((t) => t.standIn).length;
const money = (v: number | null) =>
  v === null ? "—" : v === 0 ? "$0" : v < 0.01 ? "under $0.01" : `$${v.toFixed(2)}`;
const docs = (d: { standards: number; procedures: number; policies: number } | null) =>
  d === null ? "—" : `${d.standards} / ${d.procedures} / ${d.policies}`;
---

<Base
  title="Examples"
  description={`PolicyForge run for real on public frameworks with ${modelCount} AI models, ${localCount} on a laptop: the documents as generated, what each run cost, and where models fell short.`}
>
  <main>
    <section class="page-hero">
      <div class="container">
        <p class="eyebrow">Examples</p>
        <h1>Real output, unedited.</h1>
        <p class="lede">
          We ran PolicyForge on {examples.topicCount} topics for {examples.org}, a fictional
          healthcare company, with {modelCount} AI models: {localCount} on a laptop and
          {hostedCount} hosted. Every document is shown exactly as it was generated, with its
          model, version and cost, including the models that didn’t finish.
        </p>
        {
          pending && (
            <p class="callout warn">
              <strong>Preview.</strong> The example runs haven't happened yet, so this page shows
              where each piece will go. Nothing on it is output yet
              {standIns > 0 && <>, apart from {standIns} demo answers borrowed from the PolicyForge docs and marked as such</>}.
            </p>
          )
        }
        {
          unpublished && (
            <p class="callout warn">
              <strong>Preview.</strong> The documents and figures below are the real run of{" "}
              {examples.date}. They aren't published yet, so the links are off
              {standIns > 0 && <>, and {standIns} of the demo answers further down are stand-ins from the PolicyForge docs, marked as such</>}.
            </p>
          )
        }
        <div class="btn-row">
          {
            examples.repoUrl ? (
              <a class="btn btn-primary" href={examples.repoUrl}>Browse the documents on GitHub</a>
            ) : (
              <span class="btn btn-primary is-off" aria-disabled="true">Browse the documents on GitHub</span>
            )
          }
          {
            examples.confluenceUrl ? (
              <a class="btn btn-secondary" href={examples.confluenceUrl}>See them in Confluence</a>
            ) : (
              <span class="btn btn-secondary is-off" aria-disabled="true">See them in Confluence</span>
            )
          }
        </div>
      </div>
    </section>

    <section class="section">
      <div class="container">
        <div class="section-head">
          <p class="eyebrow">Same control, {modelCount} models</p>
          <h2>One requirement, as each model wrote it.</h2>
          <p class="lede">
            Every model drafted the {examples.comparison.topic} Standard from the same framework
            text. Below is the requirement each one opens its training section with: who is
            trained, and when (NIST IR-2). It is copied as written, citations included. What
            changes is the prose, and the bill.
          </p>
        </div>
        <div class="compare">
          {
            comparisonDrafts.map((d) => {
              const m = modelByKey[d.model];
              const Excerpt = excerpts[d.model]?.Content;
              return (
                <figure class="doc" style="margin: 0;">
                  <div class="doc-head">
                    <div>
                      <div class="doc-kind">{m.label} · {m.where}</div>
                      <div class="doc-title">{examples.comparison.section}</div>
                    </div>
                    <span class="owner">{money(m.topicUsd)} for this topic</span>
                  </div>
                  <div class="doc-body excerpt">
                    {Excerpt ? (
                      <Excerpt />
                    ) : d.note ? (
                      <p class="pending-text">{d.note}</p>
                    ) : (
                      <p class="pending-text">This model's paragraph goes here, copied from its Standard.</p>
                    )}
                  </div>
                  <figcaption class="doc-foot">
                    <span>{stamp(m)}</span>
                  </figcaption>
                </figure>
              );
            })
          }
        </div>

        <div class="table-wrap" style="margin-top: 2.75rem;">
          <table>
            <thead>
              <tr>
                <th scope="col">Model</th>
                <th scope="col">Where it runs</th>
                <th scope="col">Topics finished</th>
                <th scope="col">Standards / Procedures / Policies</th>
                <th scope="col">Cost</th>
                <th scope="col">Time</th>
              </tr>
            </thead>
            <tbody>
              {
                byCost.map((m) => (
                  <>
                    <tr class={m.outcome ? "has-outcome" : ""}>
                      <th scope="row">{m.label} <span class="muted small">{m.id}</span></th>
                      <td>{m.where}</td>
                      <td>{m.topicsDone === null ? "—" : `${m.topicsDone} of ${examples.topicCount}`}</td>
                      <td>{docs(m.docs)}</td>
                      <td>
                        {money(m.costUsd)}{m.floor && "+"}
                        {m.costSource && <span class="muted small"> {m.costSource}{m.floor && ", a floor"}</span>}
                      </td>
                      <td>{m.minutes === null ? "—" : `${m.minutes} min`}</td>
                    </tr>
                    {m.outcome && (
                      <tr class="outcome">
                        <td colspan="6" class="muted small">{m.outcome}</td>
                      </tr>
                    )}
                  </>
                ))
              }
            </tbody>
          </table>
        </div>
        <p class="table-note">
          Cheapest first. Each cost is the run’s own ledger total for the {examples.topicCount}
          topics, as OpenRouter billed it: one sample, at the engine’s default effort, so treat
          it as one run rather than a rate. DeepSeek’s is a floor: the run was billed $0.86 more
          than its ledgers hold, probably for DeepSeek calls that returned no text. Time is the run’s wall clock. A topic is finished when it has
          both a Standard and a Procedure; a Policy was drafted only where every Standard under
          it was. The local model costs nothing to run, and nothing it read left the machine.
        </p>
      </div>
    </section>

    <section class="section sunk">
      <div class="container">
        <div class="section-head">
          <p class="eyebrow">One topic, top to bottom</p>
          <h2>{examples.tree.topic}: the whole set.</h2>
          <p class="lede">
            The {examples.tree.policy} Policy, the topic's Standard under it, and the Procedure
            that carries it out: from what the organization commits to down to who does what.
            Read them where they'd actually live.
          </p>
        </div>
        <ol class="tier-list">
          {
            examples.tree.docs.map((d) => (
              <li>
                <span class="tier">{d.tier}</span>
                <span class="muted">{d.says}</span>
                <span class="tier-links small">
                  {examples.repoUrl ? <a href={examples.repoUrl}>GitHub</a> : <span>GitHub</span>}
                  {" · "}
                  {examples.confluenceUrl ? <a href={examples.confluenceUrl}>Confluence</a> : <span>Confluence</span>}
                </span>
              </li>
            ))
          }
        </ol>
      </div>
    </section>

    <section class="section band" id="ask">
      <div class="container band-grid">
        <div class="section-head" style="margin-bottom: 0;">
          <p class="eyebrow">Ask Zardoz</p>
          <h2>Ask it about these policies.</h2>
          <p class="lede">
            Every answer cites the paragraph it came from, or Zardoz says the documents don't cover
            it. These are real questions with the answers it gave, recorded once and shown as is.
          </p>
        </div>
        <div class="chat demo">
          <div class="chat-label">Pick a question</div>
          {
            examples.demo.map((t, i) => (
              <details class="turn" open={i === 0} name="ask">
                <summary>
                  <span class="q-text">{t.question}</span>
                  <span class="q-shows">{t.shows}</span>
                </summary>
                <div class={`msg ${t.kind === "refusal" ? "refused" : ""}`}>
                  <span class="who"><Head />Zardoz</span>
                  {t.note && <p class="turn-note">({t.note})</p>}
                  {t.answer ? (
                    <p class={t.kind === "report" ? "report" : ""}>{t.answer}</p>
                  ) : (
                    <p class="pending-text">The real answer goes here, from the recorded session.</p>
                  )}
                  {t.cites.length > 0 && (
                    <div class="cites" style="grid-column: auto; margin-top: 0;">
                      {t.cites.map((c, n) => (
                        <span class="chip">[{n + 1}] {c}</span>
                      ))}
                    </div>
                  )}
                  {t.standIn && <p class="stand-in">Stand-in from the PolicyForge docs, over a different document set.</p>}
                </div>
              </details>
            ))
          }
        </div>
      </div>
    </section>

    <section class="section">
      <div class="container">
        <div class="cta-panel">
          <div>
            <h2>Run it on your own program.</h2>
            <p class="muted">
              The same commands made every document on this page. Start with the frameworks you
              already answer to.
            </p>
          </div>
          <div class="btn-row">
            <a class="btn btn-primary" href="/quickstart">Quick start</a>
            <a class="btn btn-secondary" href="/how-it-works">How it works</a>
          </div>
        </div>
      </div>
    </section>
  </main>
</Base>

<style>
  .compare { display: grid; gap: 1.25rem; }
  @media (min-width: 62rem) { .compare { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  .compare .doc-body p { line-height: 1.55; }
  .excerpt :global(p), .excerpt :global(li) { line-height: 1.55; }
  .excerpt :global(ul), .excerpt :global(ol) { margin: 0; padding-left: 1.25rem; display: grid; gap: 0.35rem; }
  tr.has-outcome th, tr.has-outcome td { border-bottom: 0; }
  tr.outcome td { padding-top: 0; }
  .compare .doc-foot { font-size: 0.75rem; }
  .pending-text { color: var(--muted); font-style: italic; }
  .is-off { opacity: 0.45; cursor: not-allowed; }

  .tier-list { list-style: none; padding: 0; display: grid; gap: 0.75rem; max-width: 50rem; }
  .tier-list li {
    display: grid; gap: 0.25rem 1rem; align-items: baseline;
    background: var(--bg); border: 1px solid var(--rule); border-radius: var(--radius);
    padding: 0.9rem 1.1rem;
  }
  .tier-list li:nth-child(2) { margin-left: 1.5rem; }
  .tier-list li:nth-child(3) { margin-left: 3rem; }
  @media (min-width: 48rem) { .tier-list li { grid-template-columns: 6.5rem minmax(0, 1fr) auto; } }
  .tier { font-family: var(--serif); font-weight: 600; font-size: 1.0625rem; }
  .tier-links span { color: var(--muted); }

  .demo .turn { border-bottom: 1px solid var(--band-rule); }
  .demo .turn:last-child { border-bottom: 0; }
  .demo summary {
    list-style: none; cursor: pointer; display: grid; gap: 0.15rem;
    padding: 0.95rem 1.4rem; font-weight: 600;
  }
  .demo summary::-webkit-details-marker { display: none; }
  .demo summary::before { content: "You"; font-size: 0.6875rem; letter-spacing: 0.1em; text-transform: uppercase; color: var(--band-muted); font-weight: 600; }
  .demo summary:hover .q-text, .demo summary:focus-visible .q-text { color: var(--band-accent); }
  .demo .q-shows { font-size: 0.8125rem; font-weight: 400; color: var(--band-muted); }
  .demo .turn[open] summary { padding-bottom: 0.4rem; }
  .demo .msg { border-bottom: 0; padding-top: 0.4rem; }
  .demo .turn-note { font: 0.8125rem/1.5 var(--mono); color: var(--band-muted); }
  .demo .pending-text { color: var(--band-muted); }
  .demo .stand-in { font-size: 0.75rem; color: var(--band-warn); }
  .demo .report { font-family: var(--mono); font-size: 0.875rem; white-space: pre-wrap; }
</style>
